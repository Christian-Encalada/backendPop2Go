Esta es mi base de datos actual:
-- ===========================================
-- SCRIPT SQL COMPLETO - BASE DE DATOS POP2GO
-- Incluye entidades principales + reportes
-- Arquitectura backend: Nest.js + PostgreSQL
-- ===========================================

-- TABLA: tbl_ciudades
CREATE TABLE tbl_ciudades (
  id_ciudad SERIAL PRIMARY KEY,
  nombre VARCHAR(100) UNIQUE NOT NULL
);

-- TABLA: tbl_usuarios
CREATE TABLE tbl_usuarios (
  id_usuario SERIAL PRIMARY KEY,
  nombre VARCHAR(100) NOT NULL,
  correo VARCHAR(100) UNIQUE NOT NULL,
  contrasena TEXT NOT NULL,
  telefono VARCHAR(20),
  fecha_registro TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  id_ciudad INTEGER REFERENCES tbl_ciudades(id_ciudad)
);

-- TABLA: tbl_roles
CREATE TABLE tbl_roles (
  id_rol SERIAL PRIMARY KEY,
  nombre VARCHAR(50) UNIQUE NOT NULL -- 'cliente', 'repartidor', 'admin', 'superadmin'
);

-- TABLA: tbl_usuario_roles (relación muchos a muchos)
CREATE TABLE tbl_usuario_roles (
  id_usuario INTEGER REFERENCES tbl_usuarios(id_usuario),
  id_rol INTEGER REFERENCES tbl_roles(id_rol),
  PRIMARY KEY (id_usuario, id_rol)
);

-- TABLA: tbl_productos
CREATE TABLE tbl_productos (
  id_producto SERIAL PRIMARY KEY,
  nombre VARCHAR(100) NOT NULL,
  descripcion TEXT,
  precio DECIMAL(10,2) NOT NULL,
  stock INTEGER NOT NULL,
  activo BOOLEAN DEFAULT TRUE
);

-- TABLA: tbl_direcciones
CREATE TABLE tbl_direcciones (
  id_direccion SERIAL PRIMARY KEY,
  id_usuario INTEGER REFERENCES tbl_usuarios(id_usuario) ON DELETE CASCADE,
  direccion TEXT NOT NULL,
  id_ciudad INTEGER REFERENCES tbl_ciudades(id_ciudad),
  referencia TEXT
);

-- TABLA: tbl_pedidos
CREATE TABLE tbl_pedidos (
  id_pedido SERIAL PRIMARY KEY,
  id_usuario INTEGER REFERENCES tbl_usuarios(id_usuario),
  id_direccion INTEGER REFERENCES tbl_direcciones(id_direccion),
  fecha_pedido TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  estado VARCHAR(30) CHECK (estado IN ('pendiente', 'en_camino', 'entregado', 'cancelado')),
  total DECIMAL(10,2) NOT NULL,
  tiempo_entrega INTERVAL,
  id_repartidor INTEGER REFERENCES tbl_usuarios(id_usuario)
);

-- TABLA: tbl_carrito_productos
CREATE TABLE tbl_carrito_productos (
  id_carrito SERIAL PRIMARY KEY,
  id_pedido INTEGER REFERENCES tbl_pedidos(id_pedido),
  id_producto INTEGER REFERENCES tbl_productos(id_producto),
  cantidad INTEGER NOT NULL,
  precio_unitario DECIMAL(10,2) NOT NULL
);

-- TABLA: tbl_cupones
CREATE TABLE tbl_cupones (
  id_cupon SERIAL PRIMARY KEY,
  codigo VARCHAR(20) UNIQUE NOT NULL,
  descuento DECIMAL(5,2),
  fecha_expiracion DATE
);

-- TABLA: tbl_uso_cupones
CREATE TABLE tbl_uso_cupones (
  id_uso SERIAL PRIMARY KEY,
  id_pedido INTEGER REFERENCES tbl_pedidos(id_pedido),
  id_cupon INTEGER REFERENCES tbl_cupones(id_cupon),
  fecha_uso TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- TABLA: tbl_reportes_ventas
CREATE TABLE tbl_reportes_ventas (
  id_reporte SERIAL PRIMARY KEY,
  fecha_reporte DATE NOT NULL,
  id_ciudad INTEGER REFERENCES tbl_ciudades(id_ciudad),
  total_pedidos INTEGER,
  total_ingresos DECIMAL(10,2),
  pedidos_entregados INTEGER,
  pedidos_cancelados INTEGER,
  promedio_tiempo_entrega INTERVAL
);

-- TABLA: tbl_metricas_repartidores
CREATE TABLE tbl_metricas_repartidores (
  id_metricas SERIAL PRIMARY KEY,
  id_repartidor INTEGER REFERENCES tbl_usuarios(id_usuario),
  fecha DATE,
  total_entregas INTEGER,
  promedio_tiempo_entrega INTERVAL,
  kilometros_recorridos DECIMAL(10,2),
  id_ciudad INTEGER REFERENCES tbl_ciudades(id_ciudad)
);


--INDICES
-- Usuarios por ciudad
CREATE INDEX idx_usuarios_ciudad
  ON tbl_usuarios (id_ciudad);

-- Pedidos por usuario, dirección y repartidor
CREATE INDEX idx_pedidos_usuario
  ON tbl_pedidos (id_usuario);
CREATE INDEX idx_pedidos_direccion
  ON tbl_pedidos (id_direccion);
CREATE INDEX idx_pedidos_repartidor
  ON tbl_pedidos (id_repartidor);

-- Carrito: por pedido y por producto
CREATE INDEX idx_carrito_pedido
  ON tbl_carrito_productos (id_pedido);
CREATE INDEX idx_carrito_producto
  ON tbl_carrito_productos (id_producto);

-- Uso de cupones
CREATE INDEX idx_uso_cupones_pedido
  ON tbl_uso_cupones (id_pedido);
CREATE INDEX idx_uso_cupones_cupon
  ON tbl_uso_cupones (id_cupon);

-- Reportes por ciudad
CREATE INDEX idx_reportes_ciudad
  ON tbl_reportes_ventas (id_ciudad);

-- Métricas por repartidor y ciudad
CREATE INDEX idx_metricas_repartidor
  ON tbl_metricas_repartidores (id_repartidor);
CREATE INDEX idx_metricas_ciudad
  ON tbl_metricas_repartidores (id_ciudad);


-- =====================================
-- BUENAS PRÁCTICAS A NIVEL DE CÓDIGO
-- =====================================
-- 1. Nest.js debe tener un cronjob diario que:
--    - Calcule los totales de ventas por ciudad
--    - Calcule desempeño de repartidores
--    - Inserte en las tablas de métricas/reportes

-- 2. JWT debe incluir el rol y ciudad del usuario para hacer filtros correctos en los endpoints

-- 3. Los endpoints protegidos deben validar:
--    - Si es admin: solo acceder a su ciudad
--    - Si es superadmin: puede acceder a todas

-- 4. Los reportes pueden generarse desde SQL con:
--    - Agrupaciones por ciudad y fecha
--    - Vistas o funciones SQL si deseas ahorrar lógica en el backend

-- 5. Puedes usar una librería de gráficas en React Native para mostrar datos del backend:
--    - Recharts, Victory Native, Chart Kit, etc.

-- 6. Para el sistema de roles dinámicos:
--    - Cada vez que crees un usuario, asigna sus roles con INSERT en tbl_usuario_roles
--    - En el backend, recupera los roles del usuario con JOIN para validar permisos

-- =====================================
-- Este script está optimizado para Postgres 13+.
-- Puedes migrar fácilmente con herramientas como TypeORM o Prisma.
-- =====================================



